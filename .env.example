# ==========================================
# Rely Active 2.0 Backend Environment Config
# ==========================================

NODE_ENV=development
PORT=3002

# CORS — Comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=password
DB_NAME=rely_active_2_0

# Redis Cache & Queue Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Rely Master SSO & JWT Security
JWT_SECRET=rely_master_sso_super_secret_jwt_key_2026
JWT_EXPIRES_IN=1d
SSO_MASTER_URL=http://localhost:3000

# Rate Limiting Guardrails
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Logging Level (error, warn, info, http, debug)
LOG_LEVEL=info

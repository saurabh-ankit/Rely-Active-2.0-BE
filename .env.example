# Copy to .env and fill in real values.

NODE_ENV=development
PORT=3002

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5174

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3307
DB_USER=rely_active
DB_PASS=rely_active_password
DB_NAME=rely_active

# Redis (optional at this stage; used for future queues/cache)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
